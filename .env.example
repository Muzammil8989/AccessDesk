# Copy to .env and adjust. Never commit .env.

# --- Keycloak (already running; AccessDesk only reads these) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=company-platform
KEYCLOAK_CLIENT_ID=accessdesk
# Optional: expected "aud" claim of access tokens. Defaults to KEYCLOAK_CLIENT_ID.
# KEYCLOAK_AUDIENCE=accessdesk

# --- AccessDesk database (PostgreSQL 16 from docker-compose.yml) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://accessdesk:change-me@localhost:5432/accessdesk

# --- API ---
API_PORT=4000
# Optional. Defaults to 127.0.0.1 (this machine only). Use 0.0.0.0 behind a reverse proxy.
# API_HOST=127.0.0.1
# Optional. Trust X-Forwarded-* headers. Only behind a reverse proxy you control.
# API_TRUST_PROXY=false
# Optional. Requests per client IP per minute before the API answers 429.
# RATE_LIMIT_PER_MINUTE=300
