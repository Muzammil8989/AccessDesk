# Copy to .env and adjust. Never commit .env.

# --- Identity provider (already running; AccessDesk only reads these) ---
# Optional: which adapter talks to the identity provider. Only one exists for now.
# IDENTITY_PROVIDER=keycloak
# The OIDC issuer: the "iss" claim of its tokens, and where /.well-known/openid-configuration is
# served. For the first supported provider that is http://<host>/realms/<realm>.
IDENTITY_ISSUER_URL=http://localhost:8080/realms/company-platform
IDENTITY_CLIENT_ID=accessdesk
# Optional: expected "aud" claim of access tokens. Defaults to IDENTITY_CLIENT_ID.
# IDENTITY_AUDIENCE=accessdesk
# Who may use AccessDesk and where their roles are in the token. Read by the API AND the desktop
# app, so keep them in this one file.
# Optional: comma-separated roles that may use AccessDesk (any one is enough). Default below.
# AUTH_ADMIN_ROLES=super-admin,hr-admin
# Optional: dot-separated path to the role names inside the access token. Default below.
# AUTH_ROLES_CLAIM_PATH=realm_access.roles

# --- AccessDesk database (PostgreSQL 16 from docker-compose.yml) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://accessdesk:change-me@localhost:5432/accessdesk

# --- API ---
API_PORT=4000
# Optional. Defaults to 127.0.0.1 (this machine only). Use 0.0.0.0 behind a reverse proxy.
# API_HOST=127.0.0.1
# Optional. Trust X-Forwarded-* headers. Only behind a reverse proxy you control.
# API_TRUST_PROXY=false
# Optional. Requests per client IP per minute before the API answers 429.
# RATE_LIMIT_PER_MINUTE=300
