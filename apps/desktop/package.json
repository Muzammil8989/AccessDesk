{
  "name": "@accessdesk/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AccessDesk desktop app",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @accessdesk/api build && electron-vite build && node test/e2e/run.mjs"
  },
  "devDependencies": {
    "@accessdesk/identity": "workspace:*",
    "@accessdesk/shared": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.5",
    "electron": "44.5.1",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.2",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zod": "4.6.5"
