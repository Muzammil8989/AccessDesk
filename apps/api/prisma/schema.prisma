
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemKind {
  GROUP_MEMBERSHIP
  ROLE
  MANUAL_TASK
}

enum ChecklistType {
  ONBOARDING
  OFFBOARDING
}

enum ChecklistStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ChecklistItemStatus {
  PENDING
  DONE
  SKIPPED
  FAILED
}

enum ScheduledActionType {
  DISABLE_USER
  LOGOUT_ALL_SESSIONS
  REMOVE_ALL_ACCESS
}

enum ScheduledActionStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

model OnboardingTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items      TemplateItem[]
  checklists EmployeeChecklist[]

  @@map("onboarding_templates")
}

model TemplateItem {
  id          String   @id @default(uuid()) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  title       String
  description String?
  kind        ItemKind
  targetRef   String?  @map("target_ref")
  position    Int

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, position])
  @@map("template_items")
}

model EmployeeChecklist {
  id          String          @id @default(uuid()) @db.Uuid
  subjectId   String          @map("subject_id")
  templateId  String?         @map("template_id") @db.Uuid
  type        ChecklistType
  status      ChecklistStatus @default(OPEN)
  createdBy   String          @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  completedAt DateTime?       @map("completed_at")

  template OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items    ChecklistItem[]

  @@index([subjectId])
  @@map("employee_checklists")
}

model ChecklistItem {
  id          String              @id @default(uuid()) @db.Uuid
  checklistId String              @map("checklist_id") @db.Uuid
  title       String
  description String?
  kind        ItemKind
  targetRef   String?             @map("target_ref")
  status      ChecklistItemStatus @default(PENDING)
  position    Int
  completedAt DateTime?           @map("completed_at")
  completedBy String?             @map("completed_by")

  checklist EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@unique([checklistId, position])
  @@map("checklist_items")
}

model ScheduledAction {
  id         String                @id @default(uuid()) @db.Uuid
  subjectId  String                @map("subject_id")
  action     ScheduledActionType
  runAt      DateTime              @map("run_at")
  status     ScheduledActionStatus @default(PENDING)
  createdBy  String                @map("created_by")
  createdAt  DateTime              @default(now()) @map("created_at")
  executedAt DateTime?             @map("executed_at")
  lastError  String?               @map("last_error")

  @@index([status, runAt])
  @@index([subjectId])
  @@map("scheduled_actions")
}

model OffboardingSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  subjectId   String   @map("subject_id")
  groups      Json     @default("[]")
  realmRoles  Json     @default("[]") @map("realm_roles")
  clientRoles Json     @default("[]") @map("client_roles")
  wasEnabled  Boolean  @map("was_enabled")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([subjectId])
  @@map("offboarding_snapshots")
}

model AppAuditLog {
  id              String       @id @default(uuid()) @db.Uuid
  actorId         String       @map("actor_id")
  action          String
  outcome         AuditOutcome
  targetSubjectId String?      @map("target_subject_id")
  requestId       String?      @map("request_id")
  details         Json?
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([targetSubjectId])
  @@index([createdAt])
  @@map("app_audit_log")
}
